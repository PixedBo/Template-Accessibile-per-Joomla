        <field name="ricerca_filtri_categorie_inverti" type="radio" default="0" label="TPL_ACCESSIBILE_SEARCH_FILTERS_CATEGORIES_INVERT_LABEL" description="TPL_ACCESSIBILE_SEARCH_FILTERS_CATEGORIES_INVERT_DESC" class="btn-group btn-group-yesno" showon="ricerca_filtri:1[AND]ricerca_filtri_cat:1">
          <option value="1">JYES</option>
          <option value="0">JNO</option>
        </field>
